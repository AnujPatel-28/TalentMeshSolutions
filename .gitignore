# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build
bundles/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/

# local scratch — untracked, still on disk (see docs/00-repo-cleanup-plan.md)
scratch/
tmp/
check_profiles.js
check_profiles.mjs

# InsForge & AI agent tooling
# NOTE: .agent-skills/ is deliberately TRACKED — do not add it here.
.insforge
.insforge-dist/
insforge/functions/**/*.js
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf
.codex/
.impeccable/
*.hidden
